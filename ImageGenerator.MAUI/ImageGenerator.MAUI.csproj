<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Windows-only: only platform the author can test against.
		     SDK is 22621 (Windows 11 22H2) for modern WinUI/WinRT API surface.
		     Min/supported runtime stays at 17763 so Windows 10 1809+ still runs it. -->
		<TargetFramework>net11.0-windows10.0.22621.0</TargetFramework>

		<OutputType>Exe</OutputType>
		
		<SixLaborsLicenseKey>$(SIXLABORS_LICENSE_KEY)</SixLaborsLicenseKey>
		
		<RootNamespace>ImageGenerator.MAUI</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

		<!-- PIN, load-bearing: do not remove as cleanup. The ItemsRepeater-based Windows CollectionView
		     handler that .NET 11 turned on by default cannot lay the gallery out: at 3 and 4 columns the
		     tiles in the right-hand columns jump while scrolling, and at the narrow end a tile gets
		     stretched across a whole row with its image clipped by the panel above it. Verified on device
		     2026-11-19 in three combinations, so this is not an assumption:
		         old handler  + mutate GridItemsLayout.Span   correct, tiles follow the window resize
		         new handler  + mutate GridItemsLayout.Span   jumping / stale rows
		         new handler  + replace GridItemsLayout      still jumping at 3 and 4 columns
		     So the trigger is not our layout-changing code and there is nothing here for us to fix; the
		     handler itself is the defect. Re-testing it is a device job (scroll the gallery, then
		     drag-resize across the 2/3/4 column thresholds) on every MAUI release, the same rule as a
		     _suppress* flag. Verified correct on the old handler at 2, 3 and 5 columns. Nearest upstream reports: #35102 (open, items not filling width with a gap
		     that appears on resize), #30425 (open, grid columns not shrinking), #24345 (replacing
		     ItemsLayout breaks span changes), #23266, #10144, #8387. -->
		<UseWindowsCollectionView2Handler>false</UseWindowsCollectionView2Handler>

		<NoWarn>MVVMTK0045</NoWarn>

		<!-- Emberforge identity: display name (Start menu / taskbar / manifest DisplayName), the
		     produced binary name (AssemblyName -> Emberforge.exe), and the Windows file-properties
		     fields (Task Manager / Explorer Details). The PROJECT name, csproj filename, .sln,
		     RootNamespace and ApplicationId keep their original ImageGenerator.MAUI identity on purpose
		     — renaming those churns the solution and CI for no user-visible gain. -->
		<ApplicationTitle>Emberforge</ApplicationTitle>
		<ApplicationId>io.github.mr444.imagegenerator.maui</ApplicationId>
		<AssemblyName>Emberforge</AssemblyName>
		<AssemblyTitle>Emberforge</AssemblyTitle>
		<Product>Emberforge</Product>
		<Company>Silmas</Company>
		<Authors>Silmas</Authors>
		<Description>Emberforge — a desktop image-generation workbench.</Description>
		<!-- Single source of truth for the app version. AssemblyVersion / FileVersion /
		     InformationalVersion auto-derive from <Version>; the UI reads the latter via
		     reflection. AppInfo.Current.VersionString is avoided because on Windows MAUI
		     it returns "ApplicationDisplayVersion + ApplicationVersion", not just <Version>. -->
		<Version>2.3.0</Version>
		<ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
		<ApplicationVersion>29</ApplicationVersion>

		<WindowsPackageType>None</WindowsPackageType>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="ImageGenerator.MAUI.Tests" />
	</ItemGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#15110E" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AsyncAwaitBestPractices.MVVM" Version="11.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="11.0.10" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="11.0.0" />
		<PackageReference Include="NLog" Version="6.2.2" />
		<PackageReference Include="NLog.Extensions.Logging" Version="6.3.0" />
		<!-- Refit clients use generated request builders; Refit.Reflection is not required. -->
		<PackageReference Include="Refit" Version="17.0.0" />
		<PackageReference Include="Refit.HttpClientFactory" Version="17.0.0" />
		<!-- 4.x licensed build: the license key is supplied at build time via the
	     SIXLABORS_LICENSE_KEY secret/MSBuild property (see <SixLaborsLicenseKey>). -->
		<PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
		<!-- Hardware-accelerated CRC-32/ISO-HDLC for PngTextChunkWriter (Microsoft, MIT, no transitive deps). -->
		<PackageReference Include="System.IO.Hashing" Version="11.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Update="Views\MainPage.xaml">
	    <SubType>Designer</SubType>
	  </MauiXaml>
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Views\MainPage.xaml.cs">
	    <DependentUpon>MainPage.xaml</DependentUpon>
	    <SubType>Code</SubType>
	  </Compile>
	</ItemGroup>

	<ItemGroup>
	  <AdditionalFiles Include="Presentation\Views\MainPage.xaml" />
	</ItemGroup>

</Project>
