<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:ImageGenerator.MAUI.Presentation.Behaviors"
             xmlns:converters="clr-namespace:ImageGenerator.MAUI.Presentation.Converters"
             xmlns:vm="clr-namespace:ImageGenerator.MAUI.Presentation.ViewModels"
             xmlns:vo="clr-namespace:ImageGenerator.MAUI.Core.Domain.ValueObjects"
             x:Class="ImageGenerator.MAUI.Presentation.Views.MainPage"
             x:DataType="vm:GeneratorViewModel"
             Shell.NavBarIsVisible="False"
             Padding="0">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringToEnumConverter x:Key="StringToEnumConverter" />
            <converters:ResolutionAspectRatioConverter x:Key="ResolutionAspectRatio" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- The two panes scroll independently while the action bar remains pinned. -->
    <Grid RowDefinitions="*,Auto"
          Padding="24,16,24,12"
          RowSpacing="12">

        <!-- Two independently scrolling panes: settings left, queue/results right. -->
        <Grid x:Name="MainWorkspaceGrid" Grid.Row="0"
              ColumnDefinitions="3*,2*"
              RowDefinitions="*"
              ColumnSpacing="16"
              RowSpacing="16"
              SizeChanged="OnMainWorkspaceSizeChanged">

            <!-- SETTINGS PANE: two columns of cards stacking independently,
                 so a tall Prompt card in col 0 doesn't leave a gap below API Token in col 1. -->
            <ScrollView x:Name="MainSettingsPane" Grid.Column="0">
                <Grid x:Name="SettingsCardsGrid"
                      ColumnDefinitions="*,*"
                      RowDefinitions="Auto"
                      ColumnSpacing="16"
                      RowSpacing="16"
                      Padding="0,0,12,16">

                    <VerticalStackLayout x:Name="SettingsCol0" Grid.Row="0" Grid.Column="0" Spacing="16">

                    <!-- CARD: Prompt & Model -->
                    <Border Style="{StaticResource Card}"
                            VerticalOptions="Start">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Prompt" Style="{StaticResource CardTitle}" />

                            <Grid ColumnDefinitions="*,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="12"
                                  RowSpacing="4">
                                <Label Grid.Row="0" Grid.Column="0" Text="Provider" Style="{StaticResource FieldLabel}" />
                                <Picker Grid.Row="1" Grid.Column="0"
                                        ItemsSource="{Binding ProviderFilter.Providers}"
                                        SelectedItem="{Binding ProviderFilter.SelectedProvider}"
                                        AutomationId="ProviderPicker" />
                                <Label Grid.Row="0" Grid.Column="1" Text="Model" Style="{StaticResource FieldLabel}" />
                                <Picker Grid.Row="1" Grid.Column="1"
                                        ItemsSource="{Binding ProviderFilter.FilteredModels}"
                                        SelectedItem="{Binding ProviderFilter.SelectedModel}"
                                        AutomationId="ModelPicker">
                                    <Picker.ItemDisplayBinding>
                                        <Binding Path="Display" x:DataType="vo:ModelOption" />
                                    </Picker.ItemDisplayBinding>
                                </Picker>
                            </Grid>

                            <!-- Replicate lists every model of an owner the app allow-lists, so a model
                                 can be selectable while this build knows none of its fields — and this
                                 build will not call such a model at all. Say so where the choice is
                                 made. IsVisible follows the house pattern for a conditional Label
                                 (GalleryPage, IdeaToPromptPage): the note is null for every model with
                                 a descriptor, and an empty Label would still occupy a line. The wording
                                 lives on the view model, not here, so it stays one string. -->
                            <Label Text="{Binding ModelFieldsNote}"
                                   Style="{StaticResource HelperText}"
                                   IsVisible="{Binding ModelFieldsNote, Converter={StaticResource NonEmptyStringToBool}}" />

                            <Button Text="Refresh Models"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RefreshModelsCommand}"
                                    HorizontalOptions="Start"
                                    SemanticProperties.Description="Fetch live model catalogs from Replicate and Pollinations. Replicate models require an API token. Pollinations model listing is anonymous, but generating an image requires a Pollinations API key; models tagged 'paid' also need pollen credits."
                                    AutomationId="RefreshModelsButton" />

                            <!-- One writer per direction: VM->view via OneWay binding, view->VM via the
                                 explicit TextChanged handler. The default TwoWay binding intermittently
                                 stopped pushing paste/clear/paste sequences into Parameters.Prompt on
                                 Windows, leaving validation (and generation!) on a stale prompt. -->
                            <Editor
                                Text="{Binding Parameters.Prompt, Mode=OneWay}"
                                    TextChanged="OnPromptTextChanged"
                                    Placeholder="Describe the image you want to generate…"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="90"
                                    MaximumHeightRequest="220"
                                    AutomationId="PromptEditor" />

                            <!-- Prompt tools: Describe is useful for every provider; the structure
                                 tools are only meaningful for models that consume structured JSON. -->
                            <FlexLayout Wrap="Wrap" AlignItems="Center" Margin="0,0,0,2"
                                        AutomationId="PromptToolsBar">
                                <Button Text="Describe an idea…"
                                        Command="{Binding Navigation.OpenIdeaToPromptCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,8,6"
                                        SemanticProperties.Description="Turn a freeform idea or reference image into a polished prompt"
                                        AutomationId="DescribeIdeaButton" />
                                <Button Text="Edit structure…"
                                        Command="{Binding Navigation.OpenIdeogramEditorCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,8,6"
                                        IsVisible="{Binding SupportsJsonPromptEditor}"
                                        SemanticProperties.Description="Open the visual builder for Ideogram's structured JSON prompt"
                                        AutomationId="EditStructureButton" />
                                <Button Text="Mutate current prompt…"
                                        Command="{Binding Navigation.OpenMutationEngineCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,0,6"
                                        IsVisible="{Binding SupportsJsonPromptEditor}"
                                        SemanticProperties.Description="Generate variants of the current structured prompt as a batch"
                                        AutomationId="MutateCurrentButton" />
                            </FlexLayout>

                            <!-- Gated by JsonPromptEditor (not IdeogramOptions): Ideogram V4 AND
                                 ComfyUI workflow models both consume the structured caption JSON. -->
                            <VerticalStackLayout Spacing="2" IsVisible="{Binding SupportsJsonPromptEditor}">
                                <HorizontalStackLayout Spacing="8">
                                    <CheckBox IsChecked="{Binding Parameters.UseJsonPrompt}" VerticalOptions="Center"
                                              AutomationId="JsonPromptCheckBox" />
                                    <Label Text="Structured JSON prompt" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Text="Send the prompt box as a structured caption JSON (must be valid JSON)."
                                       Style="{StaticResource HelperText}" />
                                <Label Text="{Binding JsonPromptStateText}"
                                       Style="{StaticResource HelperText}"
                                       IsVisible="{Binding JsonPromptStateText, Converter={StaticResource NonEmptyStringToBool}}"
                                       AutomationId="JsonPromptStateLabel" />
                            </VerticalStackLayout>

                            <HorizontalStackLayout Spacing="8" IsVisible="{Binding Capabilities.PromptUpsampling}">
                                <CheckBox IsChecked="{Binding Parameters.PromptUpsampling}" VerticalOptions="Center" />
                                <Label Text="Prompt upsampling" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- CARD: Input Image (optional) -->
                    <Border Style="{StaticResource Card}"
                            VerticalOptions="Start"
                            IsVisible="{Binding Capabilities.ImagePrompt}">
                        <Border.GestureRecognizers>
                            <DropGestureRecognizer AllowDrop="True"
                                                   DragOver="OnImageDragOver"
                                                   Drop="OnImageDropped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="12">
                            <Label Text="{Binding InputImages.ImagePromptCardTitle}" Style="{StaticResource CardTitle}" />
                            <Label Text="Optional reference image(s). Max count and payload field vary by model."
                                   Style="{StaticResource HelperText}" />

                            <!-- Thumbnails WRAP instead of scrolling sideways: a horizontal list
                                 in a card this narrow hides tiles off-screen with no scrollbar or
                                 wheel-scroll on Windows. The count is bounded by the
                                 descriptor (MaxImageInputs, 14 at most), so nothing needs
                                 virtualising here — a wrapping FlexLayout shows every tile and grows
                                 a row when it has to. -->
                            <FlexLayout Direction="Row"
                                        Wrap="Wrap"
                                        BindableLayout.ItemsSource="{Binding InputImages.SelectedImages}"
                                        IsVisible="{Binding InputImages.InputImageCount, Converter={StaticResource IntGreaterThanZero}}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:InputImagesCoordinator+InputImageItem">
                                        <Grid Padding="4" WidthRequest="140" HeightRequest="140">
                                            <Image Source="{Binding Preview}" Aspect="AspectFill"
                                                   SemanticProperties.Description="{Binding FileName}" />
                                            <!-- Explicit DangerButton so this remove affordance
                                                 reads as destructive (red) and stops silently
                                                 inheriting the implicit primary-purple Button style. -->
                                            <Button Text="×" FontSize="14" Padding="0"
                                                    WidthRequest="28" HeightRequest="28"
                                                    HorizontalOptions="End" VerticalOptions="Start"
                                                    Style="{StaticResource DangerButton}"
                                                    CommandParameter="{Binding .}"
                                                    Clicked="OnRemoveImageClicked"
                                                    AutomationId="RemoveImageButton" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>

                            <HorizontalStackLayout Spacing="8">
                                <Button Text="Add image"
                                        Command="{Binding InputImages.AddImageCommand}"
                                        IsEnabled="{Binding InputImages.CanAddImage}"
                                        Style="{StaticResource SecondaryButton}"
                                        AutomationId="AddImageButton" />
                                <Button Text="Clear all"
                                        Command="{Binding InputImages.ClearImagesCommand}"
                                        IsVisible="{Binding InputImages.InputImageCount, Converter={StaticResource IntGreaterThanZero}}"
                                        Style="{StaticResource SecondaryButton}"
                                        AutomationId="ClearImagesButton" />
                            </HorizontalStackLayout>

                            <Label Text="{Binding Parameters.ImagePromptStrength, StringFormat='Image prompt strength: {0:F2}'}"
                                   Style="{StaticResource FieldLabel}"
                                   IsVisible="{Binding InputImages.SupportsImagePromptStrength}" />
                            <Slider Minimum="0" Maximum="1"
                                    Value="{Binding Parameters.ImagePromptStrength, Mode=TwoWay}"
                                    HorizontalOptions="Fill"
                                    IsVisible="{Binding InputImages.SupportsImagePromptStrength}" />
                        </VerticalStackLayout>
                    </Border>

                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="SettingsCol1" Grid.Row="0" Grid.Column="1" Spacing="16">

                    <!-- CARD: Output (aspect, resolution, format, quality, safety, seed) -->
                    <Border Style="{StaticResource Card}"
                            VerticalOptions="Start">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Output" Style="{StaticResource CardTitle}" />

                            <VerticalStackLayout Spacing="4" IsVisible="{Binding Capabilities.AspectRatio}">
                                <Label Text="{Binding Capabilities.AspectRatioLabel}" Style="{StaticResource FieldLabel}" />
                                <Picker ItemsSource="{Binding Pickers.AspectRatio.Options}"
                                        SelectedItem="{Binding Pickers.AspectRatio.Selected}"
                                        MaximumWidthRequest="220"
                                        HorizontalOptions="Start"
                                        AutomationId="AspectRatioPicker" />
                            </VerticalStackLayout>

                            <!-- Single resolution picker for ALL models. Bind one Picker per
                                 PickerChoice: two simultaneously bound WinUI ComboBoxes can answer each
                                 other's null pushes (IsVisible only hides; bindings stay live). The
                                 converter decorates WxH values (Ideogram) and passes everything else
                                 ("Auto", "1K", "4.0 MP") through unchanged. -->
                            <VerticalStackLayout Spacing="4" IsVisible="{Binding SupportsResolution}">
                                <Label Text="Resolution" Style="{StaticResource FieldLabel}" />
                                <Picker ItemsSource="{Binding Pickers.Resolution.Options}"
                                        SelectedItem="{Binding Pickers.Resolution.Selected}"
                                        ItemDisplayBinding="{Binding Path=., Converter={StaticResource ResolutionAspectRatio}, x:DataType='x:String'}"
                                        MaximumWidthRequest="190"
                                        HorizontalOptions="Start"
                                        AutomationId="ResolutionPicker" />
                            </VerticalStackLayout>

                            <!-- ComfyUI only: the workflow's baked-in model, read-only — the
                                 workflow file IS the model choice (one provider entry per file),
                                 so there is nothing to pick here; label switches by loader kind
                                 (checkpoint vs UNETLoader diffusion model). -->
                            <VerticalStackLayout Spacing="4" IsVisible="{Binding ComfyUi.SupportsCheckpoint}">
                                <Label Text="{Binding ComfyUi.CheckpointLabel}" Style="{StaticResource FieldLabel}" />
                                <Label Text="{Binding ComfyUi.BakedModelName}"
                                       LineBreakMode="TailTruncation"
                                       MaximumWidthRequest="320"
                                       HorizontalOptions="Start"
                                       AutomationId="BakedModelLabel" />
                            </VerticalStackLayout>

                            <!-- ComfyUI only: quality preset from the workflow's single CustomCombo
                                 node. Options come from the file itself (option1..option4); first
                                 entry is the baked-in choice = no patch. Binds the VM-level
                                 QualityPresetChoice, never Parameters directly. -->
                            <VerticalStackLayout Spacing="4" IsVisible="{Binding ComfyUi.SupportsQualityPreset}">
                                <Label Text="Preset" Style="{StaticResource FieldLabel}" />
                                <Picker ItemsSource="{Binding ComfyUi.QualityPresetChoice.Options}"
                                        SelectedItem="{Binding ComfyUi.QualityPresetChoice.Selected}"
                                        MaximumWidthRequest="320"
                                        HorizontalOptions="Start"
                                        AutomationId="QualityPresetPicker" />
                            </VerticalStackLayout>

                            <!-- Krea-2 ComfyUI workflows only. Names come from the configured
                                 host's /models/loras catalog and are injected at queue time via
                                 the built-in LoraLoaderModelOnly node; workflow files stay clean. -->
                            <VerticalStackLayout Spacing="4" IsVisible="{Binding ComfyUi.SupportsKrea2Lora}">
                                <Label Text="LoRA" Style="{StaticResource FieldLabel}" />
                                <HorizontalStackLayout Spacing="8">
                                    <Picker ItemsSource="{Binding ComfyUi.Krea2LoraChoice.Options}"
                                            SelectedItem="{Binding ComfyUi.Krea2LoraChoice.Selected}"
                                            IsEnabled="{Binding ComfyUi.IsLoadingKrea2Loras, Converter={StaticResource InverseBool}}"
                                            MaximumWidthRequest="320"
                                            HorizontalOptions="Start"
                                            AutomationId="Krea2LoraPicker" />
                                    <Button Text="Refresh"
                                            Command="{Binding ComfyUi.RefreshKrea2LorasCommand}"
                                            IsEnabled="{Binding ComfyUi.IsLoadingKrea2Loras, Converter={StaticResource InverseBool}}"
                                            Style="{StaticResource SecondaryButton}"
                                            AutomationId="RefreshKrea2LorasButton" />
                                    <ActivityIndicator IsRunning="{Binding ComfyUi.IsLoadingKrea2Loras}"
                                                       IsVisible="{Binding ComfyUi.IsLoadingKrea2Loras}"
                                                       VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding ComfyUi.Krea2LoraStatusText}"
                                       Style="{StaticResource HelperText}"
                                       IsVisible="{Binding ComfyUi.Krea2LoraStatusText, Converter={StaticResource NonEmptyStringToBool}}" />

                                <VerticalStackLayout Spacing="2" IsVisible="{Binding ComfyUi.IsKrea2LoraSelected}">
                                    <Label Text="{Binding Parameters.ComfyUiLoraStrength, StringFormat='LoRA strength: {0:F2}'}"
                                           Style="{StaticResource HelperText}" />
                                    <Slider Minimum="-2" Maximum="2"
                                            Value="{Binding Parameters.ComfyUiLoraStrength, Mode=TwoWay}"
                                            MaximumWidthRequest="320"
                                            HorizontalOptions="Fill"
                                            AutomationId="Krea2LoraStrengthSlider" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <!-- ComfyUI only: chain the finished render into the designated
                                 upscale workflow (LoadImage-bearing, "upscale" in the file
                                 name). Both images are kept; the upscaled one gets _upscaled. -->
                            <VerticalStackLayout Spacing="2" IsVisible="{Binding ComfyUi.SupportsUpscaleAfter}">
                                <HorizontalStackLayout Spacing="8">
                                    <CheckBox IsChecked="{Binding Parameters.UpscaleAfterRender}" VerticalOptions="Center"
                                              AutomationId="UpscaleAfterRenderCheckBox" />
                                    <Label Text="Upscale after render" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding ComfyUi.UpscaleWorkflowDisplay}"
                                       Style="{StaticResource HelperText}"
                                       AutomationId="UpscaleWorkflowLabel" />
                            </VerticalStackLayout>

                            <!-- ComfyUI only: upscale_by override for the UltimateSDUpscale in
                                 play (the selected workflow itself, or the chain target). First
                                 option = the workflow's baked value = no patch. Hidden while the
                                 slot lives in the chain workflow and the chain is off, because
                                 then the factor can change nothing. -->
                            <VerticalStackLayout Spacing="4" IsVisible="{Binding ComfyUi.IsUpscaleFactorVisible}">
                                <Label Text="Upscale factor" Style="{StaticResource FieldLabel}" />
                                <Picker ItemsSource="{Binding ComfyUi.UpscaleFactorChoice.Options}"
                                        SelectedItem="{Binding ComfyUi.UpscaleFactorChoice.Selected}"
                                        MaximumWidthRequest="140"
                                        HorizontalOptions="Start"
                                        AutomationId="UpscaleFactorPicker" />
                            </VerticalStackLayout>

                            <!-- Ideogram V4: copyright detection -->
                            <HorizontalStackLayout Spacing="8" IsVisible="{Binding SupportsIdeogramOptions}">
                                <CheckBox IsChecked="{Binding Parameters.EnableCopyrightDetection}" VerticalOptions="Center"
                                          AutomationId="CopyrightDetectionCheckBox" />
                                <Label Text="Enable copyright detection" VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <VerticalStackLayout Spacing="8" IsVisible="{Binding SupportsCustomDimensions}">
                                <Label Text="Custom dimensions (px)" Style="{StaticResource FieldLabel}" />
                                <Label Text="64 - 2048 px. Flux 1.1 Pro model range: 256 - 1440."
                                       Style="{StaticResource HelperText}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="Width" Style="{StaticResource HelperText}" />
                                        <Entry Text="{Binding Parameters.Width}" Keyboard="Numeric">
                                            <Entry.Behaviors>
                                                <behaviors:NumericOnlyBehavior />
                                            </Entry.Behaviors>
                                        </Entry>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="Height" Style="{StaticResource HelperText}" />
                                        <Entry Text="{Binding Parameters.Height}" Keyboard="Numeric">
                                            <Entry.Behaviors>
                                                <behaviors:NumericOnlyBehavior />
                                            </Entry.Behaviors>
                                        </Entry>
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="4"
                                                 IsVisible="{Binding Capabilities.OutputFormatSelectable}">
                                <Label Text="Output format" Style="{StaticResource FieldLabel}" />
                                <Picker ItemsSource="{Binding OutputFormats}"
                                        SelectedItem="{Binding Parameters.OutputFormat, Converter={StaticResource StringToEnumConverter}}"
                                        MaximumWidthRequest="140"
                                        HorizontalOptions="Start" />
                            </VerticalStackLayout>

                            <HorizontalStackLayout Spacing="8" IsVisible="{Binding Capabilities.Safe}">
                                <CheckBox IsChecked="{Binding Parameters.Safe}" VerticalOptions="Center" />
                                <Label Text="NSFW filter (safe=nsfw)" VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <VerticalStackLayout Spacing="4" IsVisible="{Binding Capabilities.OutputQuality}">
                                <Label Text="{Binding Parameters.OutputQuality, StringFormat='Output quality: {0:F0}%'}"
                                       Style="{StaticResource FieldLabel}" />
                                <Slider Minimum="1" Maximum="100"
                                        Value="{Binding Parameters.OutputQuality, Mode=TwoWay}"
                                        HorizontalOptions="Fill" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="4" IsVisible="{Binding Capabilities.SafetyTolerance}">
                                <Label Text="{Binding Parameters.SafetyTolerance, StringFormat='Safety tolerance: {0:F0} (1 strictest — 6 loosest)'}"
                                       Style="{StaticResource FieldLabel}" />
                                <Slider Minimum="1" Maximum="6"
                                        Value="{Binding Parameters.SafetyTolerance, Mode=TwoWay}"
                                        HorizontalOptions="Fill" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="8" IsVisible="{Binding Capabilities.Seed}">
                                <Label Text="Seed" Style="{StaticResource FieldLabel}" />
                                <Label Text="Fixing the seed makes regeneration deterministic for the same prompt."
                                       Style="{StaticResource HelperText}" />
                                <Entry Text="{Binding Parameters.Seed}"
                                       Keyboard="Numeric"
                                       Placeholder="Seed">
                                    <Entry.Behaviors>
                                        <behaviors:NumericOnlyBehavior />
                                    </Entry.Behaviors>
                                </Entry>
                                <HorizontalStackLayout Spacing="8">
                                    <CheckBox IsChecked="{Binding Parameters.RandomizeSeed}" VerticalOptions="Center" />
                                    <Label Text="Randomize on each generation" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <!-- CivitAI draft posting (provider-independent; defaults off each launch). -->
                            <VerticalStackLayout Spacing="2">
                                <HorizontalStackLayout Spacing="8">
                                    <CheckBox IsChecked="{Binding Parameters.PostToCivitai}"
                                              VerticalOptions="Center"
                                              AutomationId="PostToCivitaiCheckBox" />
                                    <Label Text="Post to CivitAI" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Text="Publishes the saved image on CivitAI right after generation — one step, no manual publish. Needs a CivitAI API key (Settings)."
                                       Style="{StaticResource HelperText}" />
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="36,0,0,0">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding Parameters.CivitaiIncludeMeta}"
                                              IsEnabled="{Binding Parameters.PostToCivitai}"
                                              VerticalOptions="Center"
                                              AutomationId="CivitaiIncludeMetaCheckBox" />
                                    <Label Grid.Column="1" Text="Include generation data (prompt, seed, model)"
                                           VerticalOptions="Center" LineBreakMode="WordWrap" />
                                </Grid>
                                <Label Text="Sent as structured metadata with the post; the local file is never modified."
                                       Style="{StaticResource HelperText}"
                                       Margin="36,0,0,0" />
                                <VerticalStackLayout Spacing="4" Margin="36,8,0,0">
                                    <Label Text="Post to model gallery (optional)" Style="{StaticResource FieldLabel}" />
                                    <Entry Text="{Binding Parameters.CivitaiModelRef}"
                                           IsEnabled="{Binding Parameters.PostToCivitai}"
                                           Placeholder="Model URL with modelVersionId=… or the bare version id"
                                           SemanticProperties.Description="CivitAI model the post should be associated with"
                                           AutomationId="CivitaiModelRefEntry" />
                                    <Label Text="Paste the model page URL (it carries modelVersionId) — posts land in that model's gallery. Empty = plain profile post. Remembered across sessions."
                                           Style="{StaticResource HelperText}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- CARD: GPT Image advanced options (only for hosted gpt-image models; the
                         per-knob visibility is per MODEL — see SupportsGptInputFidelity /
                         SupportsGptComplexity, which is why the rows hide individually). -->
                    <Border Style="{StaticResource Card}"
                            VerticalOptions="Start"
                            IsVisible="{Binding SupportsGptQuality}">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="GPT Image options" Style="{StaticResource CardTitle}" />
                            <Label Text="Fine-grained knobs of the selected hosted gpt-image model. Which ones appear depends on the model's own schema."
                                   Style="{StaticResource HelperText}" />
                            <!-- Cost, stated where the money is decided. Quality is the priced knob on
                                 these endpoints — "The quality setting controls rendering detail and
                                 price" — and its server default is "auto", which may resolve to "max".
                                 Complexity is not priced ("Complexity doesn't change the price"); it
                                 costs time and can move parts of the image left unmentioned. -->
                            <Label Text="Quality is what the invoice measures: higher costs more. The app starts low; complexity costs time, not money."
                                   Style="{StaticResource HelperText}" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
                                    <Label Text="Quality" Style="{StaticResource FieldLabel}" />
                                    <Picker ItemsSource="{Binding Pickers.GptQuality.Options}"
                                            SelectedItem="{Binding Pickers.GptQuality.Selected}"
                                            AutomationId="GptQualityPicker" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                                    <Label Text="Background" Style="{StaticResource FieldLabel}" />
                                    <Picker ItemsSource="{Binding Pickers.GptBackground.Options}"
                                            SelectedItem="{Binding Pickers.GptBackground.Selected}"
                                            AutomationId="GptBackgroundPicker" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                                    <Label Text="Moderation" Style="{StaticResource FieldLabel}" />
                                    <Picker ItemsSource="{Binding Pickers.GptModeration.Options}"
                                            SelectedItem="{Binding Pickers.GptModeration.Selected}"
                                            AutomationId="GptModerationPicker" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4"
                                                     IsVisible="{Binding SupportsGptInputFidelity}">
                                    <Label Text="Input fidelity" Style="{StaticResource FieldLabel}" />
                                    <Picker ItemsSource="{Binding Pickers.GptInputFidelity.Options}"
                                            SelectedItem="{Binding Pickers.GptInputFidelity.Selected}"
                                            AutomationId="GptInputFidelityPicker" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="4"
                                                     IsVisible="{Binding SupportsGptComplexity}">
                                    <Label Text="Complexity" Style="{StaticResource FieldLabel}" />
                                    <Picker ItemsSource="{Binding Pickers.GptComplexity.Options}"
                                            SelectedItem="{Binding Pickers.GptComplexity.Selected}"
                                            AutomationId="GptComplexityPicker" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    </VerticalStackLayout>
                </Grid>
            </ScrollView>

            <!-- QUEUE / RESULTS PANE -->
            <ScrollView x:Name="MainResultsPane" Grid.Column="1">
                <VerticalStackLayout IsVisible="{Binding Queue.HasJobs}" Spacing="12" Padding="0,0,12,16">

                    <!-- Queue header -->
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">
                        <Label Grid.Column="0"
                               Text="Generation Queue"
                               Style="{StaticResource CardTitle}"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="Clear finished"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding Queue.ClearFinishedJobsCommand}"
                                AutomationId="ClearFinishedJobsButton" />
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Queue.Jobs}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:GenerationJob">
                                <Border Style="{StaticResource Card}">
                                    <VerticalStackLayout Spacing="8">

                                        <!-- Prompt (full, wrapping) -->
                                        <Label Text="{Binding Prompt}"
                                               Style="{StaticResource FieldLabel}"
                                               LineBreakMode="WordWrap" />

                                        <!-- Model · AR · seed -->
                                        <Label Text="{Binding MetaLine}" Style="{StaticResource HelperText}" />

                                        <!-- Mutation-engine "what changed" label (before→after); collapsed for ordinary jobs -->
                                        <Label Text="{Binding MutationLabel, StringFormat='Δ {0}'}"
                                               Style="{StaticResource HelperText}"
                                               FontAttributes="Italic"
                                               IsVisible="{Binding MutationLabel, Converter={StaticResource NonEmptyStringToBool}}"
                                               AutomationId="JobMutationLabel" />

                                        <!-- Live sampler progress (ComfyUI ws); appears with the first
                                             step report, disappears with the final outcome. -->
                                        <ProgressBar Progress="{Binding Progress}"
                                                     IsVisible="{Binding HasProgress}"
                                                     AutomationId="JobProgressBar" />

                                        <!-- Status row: spinner (if running) + status text (always) + Cancel (if running) -->
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <ActivityIndicator Grid.Column="0"
                                                               IsRunning="{Binding IsRunning}"
                                                               IsVisible="{Binding IsRunning}"
                                                               HeightRequest="18" WidthRequest="18"
                                                               VerticalOptions="Center" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding StatusMessage}"
                                                   VerticalOptions="Center"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="2">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding StatusKind}" Value="{x:Static vm:StatusKind.Success}">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource StatusSuccessLight}, Dark={StaticResource StatusSuccessDark}}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding StatusKind}" Value="{x:Static vm:StatusKind.Error}">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource StatusErrorLight}, Dark={StaticResource StatusErrorDark}}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding StatusKind}" Value="{x:Static vm:StatusKind.Canceled}">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource StatusCanceledLight}, Dark={StaticResource StatusCanceledDark}}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Button Grid.Column="2"
                                                    Text="Cancel"
                                                    Command="{Binding CancelCommand}"
                                                    Style="{StaticResource DangerButton}"
                                                    IsVisible="{Binding IsRunning}"
                                                    AutomationId="JobCancelButton" />
                                        </Grid>

                                        <!-- Result thumbnail (tap to open) -->
                                        <Border IsVisible="{Binding ResultPath, Converter={StaticResource NonEmptyStringToBool}}"
                                                Stroke="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}"
                                                StrokeThickness="1"
                                                Padding="0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="8" />
                                            </Border.StrokeShape>
                                            <Image Source="{Binding ResultPath}"
                                                   Aspect="AspectFill"
                                                   HeightRequest="260"
                                                   HorizontalOptions="Fill"
                                                   SemanticProperties.Description="Generated image. Tap to open full size.">
                                                <!-- Newest saved job is "featured": large, uncropped
                                                     (the old hero treatment). Older cards stay compact. -->
                                                <Image.Triggers>
                                                    <DataTrigger TargetType="Image" Binding="{Binding IsFeatured}" Value="True">
                                                        <Setter Property="Aspect" Value="AspectFit" />
                                                        <Setter Property="HeightRequest" Value="-1" />
                                                        <Setter Property="MaximumHeightRequest" Value="560" />
                                                    </DataTrigger>
                                                </Image.Triggers>
                                                <Image.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding OpenImageCommand}" />
                                                </Image.GestureRecognizers>
                                            </Image>
                                        </Border>

                                        <!-- Action buttons (when complete) -->
                                        <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center"
                                                    IsVisible="{Binding ResultPath, Converter={StaticResource NonEmptyStringToBool}}">
                                            <Label Text="Tap thumbnail to open full size."
                                                   Style="{StaticResource HelperText}"
                                                   VerticalOptions="Center" Margin="0,0,8,6" />
                                            <Button Text="Use as input"
                                                    Command="{Binding UseAsInputCommand}"
                                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,6"
                                                    AutomationId="JobUseAsInputButton" />
                                            <Button Text="Mutate from this"
                                                    Command="{Binding MutateFromImageCommand}"
                                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,6"
                                                    AutomationId="JobMutateFromImageButton" />
                                            <Button Text="Show in folder"
                                                    Command="{Binding ShowInFolderCommand}"
                                                    Style="{StaticResource SecondaryButton}" Margin="0,0,0,6"
                                                    AutomationId="JobShowInFolderButton" />
                                        </FlexLayout>

                                        <!-- CivitAI posting status (post-save side effect; collapsed unless posting ran) -->
                                        <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Center"
                                                    IsVisible="{Binding CivitaiStatusMessage, Converter={StaticResource NonEmptyStringToBool}}">
                                            <Label Text="{Binding CivitaiStatusMessage}"
                                                   Style="{StaticResource HelperText}"
                                                   VerticalOptions="Center"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="2"
                                                   Margin="0,0,8,6" AutomationId="JobCivitaiStatusLabel" />
                                            <Button Text="Open post"
                                                    Command="{Binding OpenCivitaiPostCommand}"
                                                    Style="{StaticResource SecondaryButton}"
                                                    IsVisible="{Binding CivitaiPostUrl, Converter={StaticResource NonEmptyStringToBool}}"
                                                    Margin="0,0,0,6" AutomationId="JobOpenCivitaiPostButton" />
                                        </FlexLayout>

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- ACTION BAR: always visible. -->
        <Border Grid.Row="1" Style="{StaticResource ActionBar}">
            <Grid RowDefinitions="Auto,Auto"
                  RowSpacing="4"
                  ColumnDefinitions="Auto,Auto,Auto,*"
                  ColumnSpacing="8">

                <Button x:Name="GenerateButton"
                        Grid.Row="0" Grid.Column="0"
                        Text="Generate Image"
                        Style="{StaticResource ActionPrimary}"
                        Command="{Binding GenerateImageCommand}"
                        IsEnabled="{Binding IsValid}"
                        MinimumWidthRequest="170"
                        VerticalOptions="Center"
                        ToolTipProperties.Text="Start image generation (Ctrl+Enter)"
                        SemanticProperties.Description="Start image generation"
                        AutomationId="GenerateButton" />

                <!-- Run and Cancel batch share the cell: their IsVisible bindings are
                     mutually exclusive, so the bar never jumps when a batch starts. -->
                <Button Grid.Row="0" Grid.Column="1"
                        Text="Run prompt batch…"
                        Style="{StaticResource SecondaryButton}"
                        Clicked="OnImportPromptsClicked"
                        IsVisible="{Binding Batch.IsBatchRunning, Converter={StaticResource InverseBool}}"
                        VerticalOptions="Center"
                        ToolTipProperties.Text="Choose a .txt file and run its prompts sequentially. Separate prompts with a blank line, a # comment line, or a line containing only ---. Lines starting with # are ignored."
                        SemanticProperties.Description="Choose a text file and run its prompts sequentially as a batch using the current model and settings"
                        AutomationId="ImportPromptsButton" />

                <Button Grid.Row="0" Grid.Column="1"
                        Text="Cancel batch"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding Batch.CancelBatchCommand}"
                        IsVisible="{Binding Batch.IsBatchRunning}"
                        VerticalOptions="Center"
                        SemanticProperties.Description="Stop the running batch and cancel queued prompts"
                        AutomationId="CancelBatchButton" />

                <Button Grid.Row="0" Grid.Column="2"
                        Text="Open output folder"
                        Command="{Binding Settings.OpenOutputFolderCommand}"
                        Style="{StaticResource SecondaryButton}"
                        VerticalOptions="Center"
                        SemanticProperties.Description="Open the generated-images folder in Explorer"
                        AutomationId="OpenFolderButton" />

                <VerticalStackLayout Grid.Row="0" Grid.Column="3"
                                     VerticalOptions="Center"
                                     Spacing="2">
                    <!-- One pinned home for the former header overview and action feedback. -->
                    <Label Text="{Binding WorkspaceSummary}"
                           Style="{StaticResource PageSubtitle}"
                           LineBreakMode="TailTruncation"
                           MaxLines="1"
                           ToolTipProperties.Text="{Binding WorkspaceSummary}"
                           AutomationId="WorkspaceSummaryLabel" />

                    <!-- A transient confirmation temporarily replaces the sticky form status. -->
                    <Grid>
                        <Label Text="{Binding FlashMessage}"
                               IsVisible="{Binding IsFlashMessageVisible}"
                               TextColor="{AppThemeBinding Light={StaticResource StatusSuccessLight}, Dark={StaticResource StatusSuccessDark}}"
                               FontAttributes="Bold"
                               LineBreakMode="TailTruncation"
                               MaxLines="1"
                               ToolTipProperties.Text="{Binding FlashMessage}"
                               AutomationId="FlashLabel" />

                        <Label Text="{Binding StatusMessage}"
                               Style="{StaticResource StatusLabel}"
                               IsVisible="{Binding IsPersistentStatusMessageVisible}"
                               LineBreakMode="TailTruncation"
                               MaxLines="1"
                               ToolTipProperties.Text="{Binding StatusMessage}"
                               AutomationId="StatusLabel" />
                    </Grid>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Spacing="2">
                    <Label Text="{Binding AiMutationStatus}"
                           Style="{StaticResource HelperText}"
                           FontAttributes="Italic"
                           IsVisible="{Binding IsAiMutationRunning}"
                           AutomationId="AiMutationBanner" />
                    <Label Text="Enter a prompt to enable generation. Replicate-hosted models also need an API token — set it under Settings in the left sidebar."
                           Style="{StaticResource HelperText}"
                           IsVisible="{Binding IsValid, Converter={StaticResource InverseBool}}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

    </Grid>
</ContentPage>
