<?xml version="1.0" encoding="UTF-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctrl="clr-namespace:ImageGenerator.MAUI.Presentation.Views.Controls"
             xmlns:vm="clr-namespace:ImageGenerator.MAUI.Presentation.ViewModels"
             x:Class="ImageGenerator.MAUI.Presentation.Views.IdeaToPromptPage"
             x:DataType="vm:IdeaToPromptViewModel"
             Title="Describe an idea"
             Shell.NavBarIsVisible="False"
             Padding="0">
    <ContentPage.Resources>
        <ResourceDictionary>

            <!-- Base look for a segmented-toggle button; the active segment is filled via a
                 per-button DataTrigger keyed on the VM's IsTextSource / IsImageSource. -->
            <Style x:Key="SegmentButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="MinimumHeightRequest" Value="40" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <!-- Same page rhythm as the generator and mutation pages: fixed header, scrolling
         workspace, fixed action/status bar. -->
    <Grid RowDefinitions="Auto,*,Auto"
          Padding="24,16,24,12"
          RowSpacing="12">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Button Grid.Column="0"
                    Text="← Back"
                    Clicked="OnBackClicked"
                    Style="{StaticResource SecondaryButton}"
                    VerticalOptions="Start"
                    AutomationId="IdeaToPromptBackButton" />
            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                <Label Text="Describe an idea → prompt" Style="{StaticResource CardTitle}" />
                <Label Text="Type a plain-English idea or pick a reference image. The builder writes prose for any provider, with optional Ideogram V4 JSON."
                       Style="{StaticResource HelperText}" />
            </VerticalStackLayout>
        </Grid>

        <Grid x:Name="WorkspaceGrid"
              Grid.Row="1"
              ColumnDefinitions="5*,4*"
              RowDefinitions="*"
              ColumnSpacing="16"
              RowSpacing="16"
              SizeChanged="OnWorkspaceSizeChanged">

            <!-- LEFT PANE: source, idea, writer options. -->
            <ScrollView x:Name="SourcePane" Grid.Column="0">
                <VerticalStackLayout Spacing="12" Padding="0,0,12,8">

                    <Border Style="{StaticResource Card}" VerticalOptions="Start">
                        <VerticalStackLayout Spacing="12">
                            <Label Text="Idea source" Style="{StaticResource CardTitle}" />

                            <!-- Segmented Text | Image toggle. -->
                            <Border Padding="3"
                                    HorizontalOptions="Start"
                                    Stroke="{AppThemeBinding Light={StaticResource SurfaceBorderLight}, Dark={StaticResource SurfaceBorderDark}}"
                                    StrokeThickness="1"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="3">
                                    <Button Grid.Column="0"
                                            Text="Text"
                                            Style="{StaticResource SegmentButton}"
                                            MinimumWidthRequest="96"
                                            Clicked="OnSelectTextSource"
                                            AutomationId="IdeaSourceTextButton">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsTextSource}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                    <Button Grid.Column="1"
                                            Text="Image"
                                            Style="{StaticResource SegmentButton}"
                                            MinimumWidthRequest="96"
                                            Clicked="OnSelectImageSource"
                                            AutomationId="IdeaSourceImageButton">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsImageSource}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>
                                </Grid>
                            </Border>
                            <Label Text="Start from a plain-English idea, or observe a reference image first."
                                   Style="{StaticResource HelperText}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- CARD: Reference image -->
                    <Border Style="{StaticResource Card}"
                            IsVisible="{Binding IsImageSource}"
                            AutomationId="ReferenceImageCard">
                        <Border.GestureRecognizers>
                            <DropGestureRecognizer AllowDrop="True"
                                                   DragOver="OnReferenceImageDragOver"
                                                   Drop="OnReferenceImageDropped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Reference image" Style="{StaticResource CardTitle}" />
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="{Binding ReferenceImageFileName}"
                                       Style="{StaticResource HelperText}"
                                       VerticalOptions="Center"
                                       LineBreakMode="MiddleTruncation" />
                                <Button Grid.Column="1"
                                        Text="Pick image"
                                        Command="{Binding PickReferenceImageCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                        Style="{StaticResource SecondaryButton}"
                                        AutomationId="PickReferenceImageButton" />
                                <Button Grid.Column="2"
                                        Text="Paste image"
                                        Clicked="OnPasteReferenceImageClicked"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                        Style="{StaticResource SecondaryButton}"
                                        AutomationId="PasteReferenceImageButton" />
                                <Button Grid.Column="3"
                                        Text="Clear"
                                        Command="{Binding ClearReferenceImageCommand}"
                                        IsVisible="{Binding HasReferenceImage}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                        Style="{StaticResource SecondaryButton}"
                                        AutomationId="ClearReferenceImageButton" />
                            </Grid>
                            <Border Stroke="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                    StrokeThickness="2"
                                    StrokeDashArray="6,4"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                    Padding="12"
                                    MinimumHeightRequest="220"
                                    AutomationId="ReferenceImageDropZone">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Grid>
                                    <VerticalStackLayout IsVisible="{Binding HasReferenceImage, Converter={StaticResource InverseBool}}"
                                                         HorizontalOptions="Center"
                                                         VerticalOptions="Center"
                                                         Spacing="6">
                                        <Label Text="Drop an image here"
                                               Style="{StaticResource CardTitle}"
                                               HorizontalTextAlignment="Center" />
                                        <Label Text="or pick a file, paste an image, or drop an image URL"
                                               Style="{StaticResource HelperText}"
                                               HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                    <Image Source="{Binding ReferenceImagePreview}"
                                           IsVisible="{Binding HasReferenceImage}"
                                           HeightRequest="220"
                                           Aspect="AspectFit"
                                           AutomationId="ReferenceImagePreview" />
                                </Grid>
                            </Border>
                            <Label Text="The image is observed first, then that observation goes through the normal VPE prompt pass."
                                   Style="{StaticResource HelperText}" />

                            <Label Text="Vision observer (image → observation)" Style="{StaticResource FieldLabel}" />
                            <!--
                                One row for the whole decision. Before this there were two rows gated on which
                                provider was selected plus a picker outside them, and the model that got called
                                was read out of the settings store by the service rather than taken from here.
                            -->
                            <ctrl:ModelPickerRow Choice="{Binding Vision}"
                                                 TitleText="Vision model"
                                                 PickerTitle="Refresh, then pick a vision model…"
                                                 IsBusy="{Binding IsBusy}"
                                                 ModelPickerAutomationId="IdeaPromptOllamaVisionModelPicker"
                                                 ProviderPickerAutomationId="VisionProviderPicker"
                                                 RefreshAutomationId="IdeaPromptOllamaVisionRefreshButton"
                                                 StatusAutomationId="IdeaPromptOllamaVisionStatusLabel" />
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="12"
                                  IsVisible="{Binding IsOpenRouterVisionProvider}">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Free models only" Style="{StaticResource FieldLabel}" />
                                    <Label Text="Filters to OpenRouter models with zero prompt and completion pricing."
                                           Style="{StaticResource HelperText}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding Generator.Settings.OpenRouterFreeOnly, Mode=TwoWay}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                        VerticalOptions="Center"
                                        AutomationId="IdeaPromptOpenRouterVisionFreeOnlySwitch" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- CARD: Idea -->
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Your idea / notes" Style="{StaticResource CardTitle}" />
                            <Editor Text="{Binding Idea}"
                                    AutoSize="TextChanges"
                                    MinimumHeightRequest="150"
                                    MaximumHeightRequest="260"
                                    Placeholder="e.g. A cozy bookshop on a rainy evening, warm lamplight, a cat asleep in the window"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                    SemanticProperties.Description="Idea or optional guidance used to build the image prompt"
                                    AutomationId="IdeaEditor" />
                            <Label Text="In text mode this is the idea. In image mode it is optional guidance for the prompt pass."
                                   Style="{StaticResource HelperText}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- CARD: Prompt writer -->
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Prompt writer (observation/idea → prompt)" Style="{StaticResource CardTitle}" />
                            <!--
                                One row, one decision, the same three providers the observer above offers.
                                This card used to pick a ModelTier instead: Local / Sonnet / Opus, which said
                                "Local" for what the card above calls "Local (Ollama)", named two Claude
                                models instead of letting the catalog say what is there, and could not offer
                                OpenRouter at all because a tier has no word for it.
                            -->
                            <ctrl:ModelPickerRow Choice="{Binding Writer}"
                                                 TitleText="Prompt writer model"
                                                 PickerTitle="Refresh, then pick a model…"
                                                 IsBusy="{Binding IsBusy}"
                                                 ModelPickerAutomationId="IdeaPromptOllamaModelPicker"
                                                 ProviderPickerAutomationId="IdeaPromptWriterProviderPicker"
                                                 RefreshAutomationId="IdeaPromptOllamaRefreshButton"
                                                 StatusAutomationId="IdeaPromptTierOllamaStatusLabel"
                                                 HelperAutomationId="IdeaPromptModelSummaryLabel" />

                            <!-- Output-format toggle lives with the writer (moved out of the source card). -->
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,4,0,0">
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding BuildJson}"
                                          VerticalOptions="Start"
                                          AutomationId="BuildJsonCheckBox" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="Also build an Ideogram V4 JSON prompt" Style="{StaticResource FieldLabel}" />
                                    <Label Text="Leave off for ordinary prompt models; turn on for structured-caption workflows."
                                           Style="{StaticResource HelperText}" />
                                </VerticalStackLayout>
                            </Grid>

                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <!-- RIGHT PANE: observation and outputs. -->
            <ScrollView x:Name="ResultPane" Grid.Column="1">
                <VerticalStackLayout Spacing="12" Padding="0,0,0,8">

                    <!-- Empty state so the results pane isn't blank before the first build. -->
                    <Border Style="{StaticResource Card}"
                            IsVisible="{Binding HasProse, Converter={StaticResource InverseBool}}"
                            AutomationId="IdeaToPromptEmptyState">
                        <VerticalStackLayout Spacing="8" Padding="8,12" HorizontalOptions="Center">
                            <Label Text="Your prompt will appear here"
                                   Style="{StaticResource CardTitle}"
                                   HorizontalOptions="Center" />
                            <Label Text="Describe an idea (or pick a reference image) on the left, then press Build prompt."
                                   Style="{StaticResource HelperText}"
                                   HorizontalTextAlignment="Center"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Card}"
                            IsVisible="{Binding ShowObservation}"
                            AutomationId="ImageObservationCard">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="Image observation"
                                       Style="{StaticResource CardTitle}"
                                       VerticalOptions="Center" />
                                <Button Grid.Column="1"
                                        Text="Observe again"
                                        Command="{Binding ReObserveCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        SemanticProperties.Description="Discard this observation so the next build describes the image again"
                                        AutomationId="ReObserveImageButton" />
                            </Grid>
                            <!-- Fixed height + internal scroll, not AutoSize: MAUI's Editor
                                 AutoSize="TextChanges" is unreliable on Windows for
                                 programmatically-bound text — an in-place value change on an
                                 already-realized editor fails to repaint (stale text). -->
                            <Editor Text="{Binding ObservedImageDescription, Mode=TwoWay}"
                                    AutoSize="Disabled"
                                    HeightRequest="260"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                    Placeholder="Built when you click Build prompt — or write your own description here."
                                    SemanticProperties.Description="What the vision model saw in the reference image; editable"
                                    AutomationId="ImageObservationEditor" />
                            <Label Text="Reused on every build until you change the image or the vision model, so a second build only re-writes the prompt. Edit this text to steer it directly."
                                   Style="{StaticResource HelperText}" />
                            <Label Text="Edited by hand — kept as-is until you press Observe again."
                                   IsVisible="{Binding ObservationEdited}"
                                   Style="{StaticResource HelperText}"
                                   AutomationId="ImageObservationEditedLabel" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Card}"
                            IsVisible="{Binding HasProse}"
                            AutomationId="ProseResultCard">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Prose prompt" Style="{StaticResource CardTitle}" />
                            <Editor Text="{Binding Prose, Mode=TwoWay}"
                                    TextChanged="OnProseTextChanged"
                                    AutoSize="Disabled"
                                    HeightRequest="260"
                                    HorizontalOptions="Fill"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                    AutomationId="ProseResultEditor" />
                            <Label Text="A normal prompt that works with any model. Copy it, or use it as your prompt."
                                   Style="{StaticResource HelperText}" />
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- ActionBar (fixed): build/cancel and status remain reachable while scrolling. -->
        <Border Grid.Row="2" Style="{StaticResource ActionBar}">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
              <FlexLayout Grid.Row="0" Direction="Row" Wrap="Wrap" AlignItems="Center">
                <Button
                        Text="Build prompt"
                        Command="{Binding BuildCommand}"
                        Style="{StaticResource ActionPrimary}"
                        MinimumWidthRequest="140" Margin="0,0,8,4"
                        SemanticProperties.Description="Build a polished prompt from the current idea or reference image"
                        AutomationId="BuildPromptButton" />
                <Button
                        Text="Cancel"
                        Command="{Binding CancelCommand}"
                        IsVisible="{Binding IsBusy}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,4" AutomationId="CancelBuildButton" />
                <ActivityIndicator
                                   IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   WidthRequest="22"
                                   HeightRequest="22"
                                   VerticalOptions="Center"
                                   Margin="0,0,8,4" AutomationId="IdeaToPromptBusyIndicator" />
                <Button
                        Text="Copy prose"
                        Command="{Binding CopyProseCommand}"
                        IsVisible="{Binding HasProse}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,4" AutomationId="CopyProseButton" />
                <Button
                        Text="Use prose as prompt"
                        Command="{Binding UseProseCommand}"
                        IsVisible="{Binding HasProse}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,4"
                        AutomationId="UseProseButton" />
                <Button
                        Text="Use JSON prompt"
                        Command="{Binding UseJsonCommand}"
                        IsVisible="{Binding HasJson}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,4"
                        AutomationId="UseJsonButton" />
              </FlexLayout>
                <Label Grid.Row="1"
                       Text="{Binding StatusMessage}"
                       Style="{StaticResource StatusLabel}"
                       IsVisible="{Binding StatusMessage, Converter={StaticResource NonEmptyStringToBool}}"
                       LineBreakMode="WordWrap"
                       VerticalOptions="Center"
                       AutomationId="IdeaToPromptStatusLabel" />
            </Grid>
        </Border>

    </Grid>
</ContentPage>
